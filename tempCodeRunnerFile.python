import os
import sys
import json
import queue
import sounddevice as sd
import vosk
import pyttsx3
import datetime

VOSK_MODEL_PATH = "vosk-model-small-hi-0.22"
MEMORY_FILE = "memory.json"

# Load Hindi ASR model
if not os.path.exists(VOSK_MODEL_PATH):
    print("❌ Hindi model not found! Pehle download karo: https://alphacephei.com/vosk/models")
    sys.exit(1)

model = vosk.Model(VOSK_MODEL_PATH)
q = queue.Queue()

def callback(indata, frames, time, status):
    if status:
        print(status, file=sys.stderr)
    q.put(bytes(indata))

# Hindi TTS
engine = pyttsx3.init()
engine.setProperty("voice", "hindi")  # Windows me Hindi voice install hona chahiye
engine.setProperty("rate", 150)

def speak(text):
    print("🤖:", text)
    engine.say(text)
    engine.runAndWait()

# Memory
if os.path.exists(MEMORY_FILE):
    with open(MEMORY_FILE, "r", encoding="utf-8") as f:
        memory = json.load(f)
else:
    memory = {"items": {}, "notes": []}

def save_memory():
    with open(MEMORY_FILE, "w", encoding="utf-8") as f:
        json.dump(memory, f, ensure_ascii=False, indent=4)

# Process commands
def process(text):
    text = text.lower()
    if "याद रखो" in text:
        # Example: "याद रखो मेरा पर्स बैग में है"
        words = text.split()
        if "मेरा" in words:
            try:
                idx = words.index("मेरा")
                item = words[idx+1]
                place = " ".join(words[idx+2:])
                memory["items"][item] = place
                save_memory()
                speak(f"ठीक है, मैंने याद रख लिया कि {item} {place} है।")
            except:
                speak("कृपया पूरा वाक्य बोलो।")
    elif "कहाँ है" in text:
        words = text.split()
        item = words[1] if len(words) > 1 else ""
        if item in memory["items"]:
            speak(f"{item} {memory['items'][item]} है।")
        else:
            speak(f"मुझे {item} के बारे में जानकारी नहीं है।")
    elif "समय" in text:
        now = datetime.datetime.now().strftime("%H:%M")
        speak(f"अभी समय है {now}")
    elif "दिनांक" in text or "तारीख" in text:
        date = datetime.datetime.now().strftime("%d %B %Y")
        speak(f"आज की तारीख है {date}")
    elif "नोट कर लो" in text:
        note = text.replace("नोट कर लो", "").strip()
        memory["notes"].append(note)
        save_memory()
        speak("ठीक है, मैंने नोट कर लिया।")
    elif "नोट्स" in text:
        if memory["notes"]:
            speak("आपके नोट्स हैं: " + ", ".join(memory["notes"]))
        else:
            speak("आपके पास कोई नोट नहीं है।")
    elif "बंद" in text or "रुको" in text:
        speak("ठीक है, अलविदा!")
        sys.exit(0)
    else:
        speak("मुझे इसका उत्तर नहीं पता, पर मैं सीख रहा हूँ।")

# Main Loop
def listen():
    with sd.RawInputStream(samplerate=16000, blocksize=8000, dtype="int16",
                           channels=1, callback=callback):
        rec = vosk.KaldiRecognizer(model, 16000)
        speak("नमस्ते! मैं हिंदी असिस्टेंट हूँ। आप क्या पूछना चाहते हो?")
        while True:
            data = q.get()
            if rec.AcceptWaveform(data):
                result = json.loads(rec.Result())
                if result.get("text"):
                    print("🗣", result["text"])
                    process(result["text"])

if _name_ == "_main_":
    listen()